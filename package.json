{
  "name": "simplework",
  "version": "0.1.0",
  "description": "SimpleWork - 本地优先的轻量 Agent 工作台。预置大模型 / MCP / Skills，全部由本地配置驱动。",
  "type": "module",
  "bin": {
    "simplework": "./dist/index.js",
    "sw": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/web/public','dist/web/public',{recursive:true})\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "desktop:build": "npm run build && node desktop/scripts/build-desktop.mjs --payload-only",
    "desktop:start": "npm run desktop:build && npm --prefix desktop run start",
    "desktop:dist": "npm run desktop:build && npm --prefix desktop run dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "MIT"
}
