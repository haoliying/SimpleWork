# SimpleWork 环境变量示例
# 用法：复制本文件到 ~/.simplework/.env（全局）或 ./.simplework/.env（项目级），填入你的 Key。
# 只填你真正要用的那几个即可，其余留空不影响启动。

# ---------- 国产大模型 ----------
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ARK_API_KEY=
SILICONFLOW_API_KEY=
MINIMAX_API_KEY=

# ---------- 国际大模型 ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ---------- 本地模型 ----------
OLLAMA_API_KEY=ollama
LOCAL_API_KEY=EMPTY

# ---------- 搜索（可选，不填则用免密钥的 DuckDuckGo）----------
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---------- MCP 服务器所需密钥（按需填，对应 sw mcp enable 的服务器）----------
GITHUB_TOKEN=
AMAP_MAPS_API_KEY=
DATABASE_URL=
MY_MCP_TOKEN=
